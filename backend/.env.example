# =============================================================================
# Business POS Backend — Environment configuration (example)
# Copy to `.env` and adjust for your environment.
# =============================================================================

# ---- App ----
POS_ENV=development                 # development | test | production
POS_DEBUG=true                      # verbose logging + stack traces
POS_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

# ---- HTTP server ----
POS_HOST=127.0.0.1
POS_PORT=8000
# Comma-separated allowed CORS origins. Empty = same-origin only.
POS_CORS_ALLOWED_ORIGINS=
# Comma-separated trusted hosts. Empty = no restriction (dev only).
POS_TRUSTED_HOSTS=
# Maximum allowed request body size in bytes (default 1 MiB).
POS_MAX_BODY_BYTES=1048576

# ---- Database ----
# Format: postgresql+asyncpg://user:password@host:port/dbname
POS_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/pos_dev
POS_DATABASE_POOL_SIZE=10
POS_DATABASE_MAX_OVERFLOW=20
POS_DATABASE_POOL_TIMEOUT_SECONDS=10
POS_DATABASE_STATEMENT_TIMEOUT_MS=30000

# ---- Auth ----
# Lifetime of an access token in seconds (default 15 min).
POS_ACCESS_TOKEN_TTL_SECONDS=900
# Lifetime of a refresh token in seconds (default 7 days).
POS_REFRESH_TOKEN_TTL_SECONDS=604800
# Maximum number of failed login attempts before lockout.
POS_MAX_FAILED_LOGINS=5
# Lockout window in seconds.
POS_FAILED_LOGIN_WINDOW_SECONDS=900
# Lockout duration in seconds.
POS_LOCKOUT_DURATION_SECONDS=900

# ---- Idempotency ----
# Default TTL for idempotency keys in seconds.
POS_IDEMPOTENCY_DEFAULT_TTL_SECONDS=86400
# TTL for /auth/login idempotency keys in seconds.
POS_IDEMPOTENCY_LOGIN_TTL_SECONDS=30

# ---- Observability ----
POS_LOG_FORMAT=json                # json | console
